# Telegram Assistant — yapılandırma şablonu
# Bu dosyayı `.env` olarak kopyalayıp doldurun. `.env` asla depoya eklenmez (.gitignore).
# Her anahtar ortam değişkeni olarak da verilebilir; ortam değişkeni .env'den önce gelir.
# İsteğe bağlı anahtarlar yorum satırıdır; köşeli parantezdeki değer varsayılandır.
# Önemli: etkin ama boş bir satır (ANAHTAR=) varsayılanı geçersiz kılar. Kullanmayacağınız anahtarı
# boş bırakmak yerine yorum satırı olarak tutun.

# --- Telegram (zorunlu) -------------------------------------------------------
# @BotFather ile oluşturulan sohbet botunun jetonu. Yoksa servis yalnızca tek yönlü çalışır.
TELEGRAM_SOHBET_JETONU=
# Botla konuşacak tek kişinin Telegram sohbet kimliği. Başka sohbetlerden gelen mesajlar yok sayılır.
TELEGRAM_SOHBET_ID=
# (İsteğe bağlı) Yedek gönderici bot: sohbet botu gönderemezse bildirimler buradan gider.
# Bu botta getUpdates çağrılmaz; yalnızca gönderim için kullanılır.
# TELEGRAM_YEDEK_JETONU=
# TELEGRAM_YEDEK_SOHBET_ID=

# --- Notion (takvim, hatırlatma ve not veritabanları) -------------------------
# Notion entegrasyon jetonu (https://www.notion.so/profile/integrations)
NOTION_KEY=
# Veritabanı (data source) kimlikleri; entegrasyon bu veritabanlarına bağlanmış olmalı.
# NOTION_TAKVIM_DS=
# NOTION_HATIRLATMA_DS=
# NOTION_NOT_DS=
# Sonuç sayfalarının oluşturulacağı üst sayfanın kimliği
# NOTION_ANA_SAYFA=

# --- Okul postası (IMAP, salt okunur: EXAMINE + BODY.PEEK) ---------------------
# OKUL_EPOSTA_KULLANICI=
# OKUL_EPOSTA_SIFRE=
# [imap.example.edu]
# OKUL_IMAP_SUNUCU=imap.example.edu
# Öğrenme yönetim sisteminin bildirim gönderdiği adres [learn@example.edu]
# OKUL_LEARN_GONDEREN=learn@example.edu

# --- Gmail (uygulama şifresiyle IMAP) -----------------------------------------
# GMAIL_KULLANICI=
# GMAIL_UYGULAMA_SIFRESI=

# --- Beyin (Claude Code CLI) --------------------------------------------------
# Sohbet beyni modeli [sonnet]; SOHBET_MODEL verilmezse BEYIN_MODEL kullanılır
# BEYIN_MODEL=sonnet
# BEYIN_EFFORT=
# SOHBET_MODEL=
# SOHBET_EFFORT=
# ⟦GÖREV⟧ ile başlatılan arka plan oturumlarının modeli [sonnet]
# GOREV_MODEL=sonnet
# Görevlerin çalışabileceği projeler (şablon: projeler.example.json) [projeler.json]
# GOREV_PROJELER_DOSYASI=projeler.json
# 0: cevaplar yazıldıkça gösterilmez, bitince tek mesaj gider [1]
# AKISLI_CEVAP=1

# --- Zamanlama ----------------------------------------------------------------
# Bu aralıkta "önemli" bildirimler sessiz gider [23:30-08:00]
# SESSIZ_SAAT=23:30-08:00
# Ertesi günü planlayan gece görevinin saati [23:30]
# PLAN_SAATI=23:30
# Pazar günü haftalık hafıza özetinin saati [21:00]
# HAFIZA_SAATI=21:00
# Ödev takip mesajlarının aralığı, saat [2]
# TAKIP_SAAT=2
# Doluysa takip bu saatlerde gider, örn. "09:00,20:00" []
# TAKIP_SAATLERI=

# --- Sesli mesaj (faster-whisper) ---------------------------------------------
# Ses işçisi bu kadar saniye boşta kalınca kapanır [600]
# SES_BOSTA_SN=600
# [large-v3-turbo]
# SES_MODEL=large-v3-turbo

# --- Bulut hatırlatıcısı (bulut/ klasöründeki Cloudflare Worker) --------------
# bulut/kur.ps1 bu iki değeri yazar; yoksa bulut kapalı kalır.
# BULUT_URL=
# BULUT_JETON=

# --- Hava durumu (Open-Meteo) -------------------------------------------------
# enlem,boylam [39.93,32.86]
# HAVA_KONUM=39.93,32.86
# Görünen yer adı [Ankara]
# HAVA_YER=Ankara

# --- Sistem kontrolleri -------------------------------------------------------
# Disk doluluğu izlenecek sürücü harfleri, virgülle [C]
# DISKLER=C
# İzlenecek Windows servisi ve adresi (isteğe bağlı)
# PANEL_SERVISI=
# PANEL_URL=
# 1: Tailscale / Syncthing durumunu da denetle [0]
# TAILSCALE_KONTROL=0
# SYNCTHING_PORT=0
# Ağda varlığı izlenecek cihaz (isteğe bağlı)
# AG_CIHAZI_IP=
# AG_CIHAZI_AD=

# --- Klasörler (varsayılanlar proje klasörü altındadır; değiştirecekseniz mutlak yol verin) ---
# [veri/takvim]
# TAKVIM_KLASORU=/yol/takvim
# [ortak]
# ORTAK_KLASOR=/yol/ortak
# [ortak/odevler]
# ODEV_KLASORU=/yol/odevler
# Ders kayıtlarının ve notlarının bulunduğu klasör [panopto]
# PANOPTO_KLASORU=/yol/panopto
# Kayıt indirme betiklerinin klasörü [panopto-arac]
# PANOPTO_ARAC_KLASORU=/yol/panopto-arac

# --- Yerel kontrol arayüzü (yalnızca 127.0.0.1) -------------------------------
# [7341]
# KONTROL_PORT=7341
# [servis.log]
# GUNLUK_DOSYASI=servis.log
